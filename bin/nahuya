#!/bin/sh
# nahuya CLI: state and diffs for the over-engineering review loop.
# Run `nahuya help` for usage.

NH_ROOT=$(cd "$(dirname "$0")/.." && pwd) || exit 1
. "$NH_ROOT/lib/nahuya.sh"

usage() {
  cat <<'EOF'
nahuya status [tests] [base..tip]                   range, settings and loop context
nahuya diff --round K [--full] [--only-tests] [base..tip]  write the diff for review round K
nahuya diff --target [--only-tests] [range|branch]  write a diff for a one-off review
nahuya shards [all|PATH] [--plan FILE] [--top N|--skip K]
              [--tests|--no-tests|--prune-tests|--only-tests] [--with-nonprod] [--loop]
                                                    one review shard per "## component" of the plan
nahuya inventory [all|PATH] [--files DIR] [--tests|--no-tests|--only-tests] [--with-nonprod]
                                                    map of directories for planning components
nahuya clones [all|PATH] [--min-lines N] [--tests|--no-tests|--only-tests] [--with-nonprod]
                                                    find near-duplicate code across files
nahuya log ROUND DECISION CATEGORY ID TEXT...       record a decision (applied|rejected|needs-context)
nahuya mark [--keep-anchor]                         mark HEAD as reviewed (ends a loop)
nahuya skip                                         skip review of everything up to HEAD
nahuya config [KEY [VALUE|--unset] [--global|--project]]  show or change settings
nahuya stats                                        what past reviews applied and rejected
nahuya aliases [install|remove]                     short /nah-review, /nah-polish, ... commands
EOF
}

require_repo() { nh_enter_repo || nh_die "not inside a git repository"; }

# Sets ANCHOR, BASE (review base), NH_TIP, NH_BRANCH from an optional base..tip.
resolve_range() {
  case ${1-} in
    *...*) _b=${1%%...*}; _t=${1##*...} ;;
    *..*) _b=${1%%..*}; _t=${1##*..} ;;
    '') _b=; _t= ;;
    *) _b=; _t=$1 ;;
  esac
  nh_resolve_tip "${_t:-HEAD}" || nh_die "unknown revision: ${_t:-HEAD}"
  if [ -n "$_b" ]; then
    ANCHOR=$(git rev-parse -q --verify "$_b^{commit}") || nh_die "unknown revision: $_b"
    case $1 in *...*) ANCHOR=$(git merge-base "$ANCHOR" "$NH_TIP") ;; esac
    BASE=$ANCHOR
  else
    ANCHOR=$(nh_anchor "$NH_TIP" "$NH_BRANCH") ||
      nh_die "no upstream or remote default branch to compare against; pass a range like main..HEAD"
    BASE=$(nh_review_base "$ANCHOR" "$NH_TIP" "$NH_BRANCH")
  fi
}

cmd_status() {
  # Also takes what the skills pass along: `tests`, --only-tests, `all` or a path.
  _range=; _target=; _pv=
  for _a in "$@"; do
    if [ -n "$_pv" ]; then export NAHUYA_PASSES=$_a; _pv=; continue; fi
    case $_a in
      --passes) _pv=1 ;;
      --passes=*) export NAHUYA_PASSES=${_a#--passes=} ;;
      --only-tests) export NH_ONLY_TESTS=1 ;;
      --tests|--no-tests|--prune-tests|--with-nonprod|--loop) ;;  # whole-repo flags the skills may pass along
      tests) if git rev-parse -q --verify "tests^{commit}" >/dev/null 2>&1; then _range=$_a; else export NH_ONLY_TESTS=1; fi ;;
      *) if [ "$_a" = all ] || { [ -e "$_a" ] && ! git rev-parse -q --verify "$_a^{commit}" >/dev/null 2>&1; }; then _target=$_a; else _range=$_a; fi ;;
    esac
  done
  set -- $_range
  require_repo
  if [ -n "${1-}" ]; then
    resolve_range "$1"
  else
    nh_resolve_tip HEAD || nh_die "no commits yet"
    if ANCHOR=$(nh_anchor "$NH_TIP" "$NH_BRANCH"); then
      BASE=$(nh_review_base "$ANCHOR" "$NH_TIP" "$NH_BRANCH")
    else
      ANCHOR=; BASE=
    fi
  fi
  if git for-each-ref --contains "$NH_TIP" --format=x refs/remotes 2>/dev/null | grep -q .; then _pushed=yes; else _pushed=no; fi
  echo "repo=$NH_TOP"
  echo "branch=${NH_BRANCH:-(detached)}"
  [ -z "$_target" ] || echo "target=$_target (existing code: see nahuya inventory and shards)"
  [ -z "${NH_ONLY_TESTS-}" ] || echo "scope=tests-only"
  if [ -n "$ANCHOR" ]; then
    echo "range=$(nh_short "$BASE")..$(nh_short "$NH_TIP")"
    echo "unreviewed_added_lines=$(nh_count_added "$ANCHOR" "$NH_TIP" "$NH_BRANCH") (own code only: no tests, docs, data or generated files)"
  else
    echo "range=none (no upstream or remote default branch; pass base..tip, or review a path)"
  fi
  for _k in $NH_KEYS; do echo "$_k=$(nh_cfg "$_k")"; done
  echo "head_pushed=$_pushed"
  echo "check=$(nh_md_scalar check)"
  if _l=$(session_ledger); then echo "ledger=$_l (review loop in progress)"
  elif [ -n "$ANCHOR" ]; then echo "ledger=$(nh_ledger_path "$ANCHOR" "$NH_BRANCH")"; fi
  [ -n "$BASE" ] || return 0
  _range_files=$(git -c core.quotePath=false diff --name-only --no-renames "$BASE" "$NH_TIP" 2>/dev/null)
  git -c core.quotePath=false status --porcelain=v1 -uno 2>/dev/null | cut -c4- |
    NH_RF=$_range_files awk 'BEGIN { n = split(ENVIRON["NH_RF"], a, "\n"); for (i = 1; i <= n; i++) r[a[i]] = 1 } ($0 in r) { print "uncommitted=" $0 }'
}

cmd_diff() {
  _round=; _full=; _target=; _has_target=
  while [ $# -gt 0 ]; do
    case $1 in
      --round) _round=${2-}; shift 2 || shift ;;
      --only-tests) export NH_ONLY_TESTS=1; shift ;;
      --full) _full=1; shift ;;
      --passes) shift 2 || shift ;;
      --passes=*) shift ;;
      --target) _has_target=1; shift ;;
      tests) if git rev-parse -q --verify "tests^{commit}" >/dev/null 2>&1; then _range=$1; else export NH_ONLY_TESTS=1; fi; shift ;;
      *) if [ -n "$_has_target" ]; then _target=$1; else _range=$1; fi; shift ;;
    esac
  done
  require_repo
  mkdir -p "$NH_STATE"
  if [ -n "$_has_target" ]; then diff_target "$_target"; return; fi
  case $_round in ''|*[!0-9]*) nh_die "usage: nahuya diff --round K [--full] [range]" ;; esac
  if [ "$_round" -le 1 ]; then resolve_range "${_range-}"; else nh_resolve_tip HEAD || nh_die "no commits yet"; fi
  _rd=$NH_STATE/rounds/$(nh_branch_key "$NH_BRANCH")
  _out=$_rd/round-$_round.diff
  if [ "$_round" -le 1 ]; then
    rm -rf "$_rd"; mkdir -p "$_rd"
    printf '%s\n%s\n%s\n%s\n' "$ANCHOR" "$BASE" "$NH_BRANCH" "$(nh_count_added "$ANCHOR" "$NH_TIP" "$NH_BRANCH")" > "$_rd/session"
    nh_snapshot > "$_rd/tree-1"
    ledger_init "$(nh_ledger_path "$ANCHOR" "$NH_BRANCH")"
    _n=$(nh_write_diff "$BASE" "$NH_TIP" "$_out")
  else
    [ -f "$_rd/session" ] || nh_die "no review loop in progress; start with: nahuya diff --round 1"
    _prev=$_rd/tree-$((_round - 1))
    [ -f "$_prev" ] || nh_die "round $((_round - 1)) was not started"
    _now=$(nh_snapshot); printf '%s\n' "$_now" > "$_rd/tree-$_round"
    if [ -n "$_full" ]; then
      _n=$(nh_write_diff "$(sed -n 2p "$_rd/session")" "$_now" "$_out")
    else
      _n=$(nh_write_diff "$(cat "$_prev")" "$_now" "$_out")
    fi
  fi
  echo "diff=$_out"
  echo "files=$_n"
  echo "lines=$(wc -l < "$_out" | tr -d ' ')"
  [ -z "${NH_ONLY_TESTS-}" ] || echo "scope=tests-only"
}

diff_target() {
  _out=$NH_STATE/review.diff
  case $1 in
    '')
      nh_resolve_tip HEAD || nh_die "no commits yet"
      _a=$(nh_anchor "$NH_TIP" "$NH_BRANCH") || nh_die "nothing to compare against; pass a range like main..HEAD"
      _n=$(nh_write_diff "$(nh_review_base "$_a" "$NH_TIP" "$NH_BRANCH")" "$(nh_snapshot)" "$_out")
      if [ "$_n" = 0 ] && git rev-parse -q --verify HEAD~1 >/dev/null 2>&1; then
        _n=$(nh_write_diff HEAD~1 HEAD "$_out")
        echo "note=nothing unreviewed; showing the last commit instead"
      fi ;;
    *..*)
      resolve_range "$1"; _n=$(nh_write_diff "$BASE" "$NH_TIP" "$_out") ;;
    *)
      nh_resolve_tip "$1" || nh_die "not a revision or range: $1 (for a path, use: nahuya shards $1)"
      _b=$(nh_fallback_base "$NH_TIP" "$NH_BRANCH") || nh_die "nothing to compare $1 against; pass a range"
      _n=$(nh_write_diff "$_b" "$NH_TIP" "$_out") ;;
  esac
  echo "diff=$_out"
  echo "files=$_n"
  echo "lines=$(wc -l < "$_out" | tr -d ' ')"
}

# The selection flags shards, inventory and clones share. Returns 1 for anything else.
sel_flag() {
  case $1 in
    --no-tests) _notests=1 ;;
    --tests|--prune-tests) _notests= ;;
    --only-tests) export NH_ONLY_TESTS=1 ;;
    --with-nonprod) _nonprod=1 ;;
    *) return 1 ;;
  esac
}

# Over-engineering signal counts per selected file ("path:N").
signal_counts() {
  (cd "$NH_TOP" && printf '%s\n' "$SEL_ALL" | tr '\n' '\000' |
    xargs -0 git -c core.quotePath=false grep -I -c -E "$NH_SIGNALS" -- 2>/dev/null)
}

# One line per non-production folder the selection left out, biggest first.
nonprod_summary() {
  [ -n "$SEL_SKIPPED" ] || return 0
  printf '%s\n' "$SEL_SKIPPED" | grep . | count_lines | awk -F'\t' -v re="$NH_NONPROD_RE" '
    { p = $2; if (match(p, re)) { k = substr(p, 1, RSTART + RLENGTH - 1); sub(/^\//, "", k); s[k] += $1 } }
    END { for (k in s) printf "%d\t%s\n", s[k], k }' | sort -t "$NH_TAB" -k1,1nr |
    awk -F'\t' '{ printf "skipped_nonprod=%s (%d lines; pass --with-nonprod to include)\n", $2, $1 }'
}

# Files for a whole-repo or folder run, one per line, grouped by directory.
# Sets SEL_ALL (every candidate), SEL_FILES (after the test choice), SEL_TESTS
# ("path<TAB>all" for test files, "path<TAB>N" for N lines of inline tests),
# SEL_KEY (state dir name; tests-only runs get their own). Options: --no-tests,
# --with-nonprod. Non-production dirs are skipped by default and reported.
select_files() {
  _target=${1:-.}; _notests=$2; _nonprod=$3
  if [ -n "${NH_ONLY_TESTS-}" ] && [ -n "$_notests" ]; then nh_die "--only-tests and --no-tests contradict each other"; fi
  if [ "$_target" = all ] && [ ! -e all ]; then _target=$NH_TOP; fi
  SEL_KEY=$(printf '%s' "${1:-all}" | sed 's#^\./##; s#/*$##')
  case $SEL_KEY in ''|.|all) SEL_KEY=all ;; esac
  SEL_KEY=$(printf '%s' "$SEL_KEY" | tr -c 'A-Za-z0-9._-' '_')
  [ -z "${NH_ONLY_TESTS-}" ] || SEL_KEY=tests-$SEL_KEY
  _ot=${NH_ONLY_TESTS-}; NH_ONLY_TESTS=  # every file first; the test choice comes below
  _all=$(git -c core.quotePath=false grep -I -l --full-name -e '' -- "$_target" 2>/dev/null | nh_keep review)
  NH_ONLY_TESTS=$_ot
  if [ -d "$_target" ]; then
    _all=$(printf '%s\n' "$_all" | while IFS= read -r _f; do nh_is_doc "$_f" || printf '%s\n' "$_f"; done)
  fi
  [ -n "$_all" ] || nh_die "no tracked text files to review under $_target"
  SEL_SKIPPED=
  if [ -z "$_nonprod" ]; then
    SEL_SKIPPED=$(printf '%s\n' "$_all" | grep -E "$NH_NONPROD_RE")
    _all=$(printf '%s\n' "$_all" | grep -v -E "$NH_NONPROD_RE")
  fi
  # group by directory: sort by (dirname, path)
  SEL_ALL=$(printf '%s\n' "$_all" | awk 'NF { d = $0; if (!sub(/\/[^\/]*$/, "", d)) d = "."; print d "\t" $0 }' | LC_ALL=C sort | cut -f2-)
  SEL_TESTS=$( {
    printf '%s\n' "$SEL_ALL" | while IFS= read -r _f; do
      [ -n "$_f" ] && nh_is_test "$_f" && ! nh_is_data "$_f" && printf '%s\tall\n' "$_f"
    done
    case $SEL_ALL in (*.rs|*.rs"$NH_NL"*) nh_rust_tests ;; esac
  } | NH_SEL=$SEL_ALL awk -F'\t' 'BEGIN { n = split(ENVIRON["NH_SEL"], a, "\n"); for (i = 1; i <= n; i++) in_sel[a[i]] = 1 }
      ($1 in in_sel) && !($1 in seen) { seen[$1] = 1; print }')
  SEL_FILES=$(printf '%s\n' "$SEL_ALL" | NH_T=$SEL_TESTS awk -v only="${NH_ONLY_TESTS-}" -v notests="$_notests" '
    BEGIN { n = split(ENVIRON["NH_T"], t, "\n"); for (i = 1; i <= n; i++) { split(t[i], f, "\t"); if (f[1] != "") tl[f[1]] = f[2] } }
    NF && !(only != "" && !($0 in tl)) && !(notests != "" && tl[$0] == "all")')
}

# "path<TAB>lines" for each file listed in shard files ("path (N lines)" or
# "path (N test lines of M)").
shard_entries() {
  cat "$@" 2>/dev/null | sed -n 's/^\(.*\) (\([0-9]*\) \(test \)*lines.*)$/\1	\2/p'
}

# Line counts for a file list on stdin ("count<TAB>path").
count_lines() {
  (cd "$NH_TOP" && tr '\n' '\000' | xargs -0 wc -l 2>/dev/null) |
    awk '{ c = $1; p = $0; sub(/^[ \t]*[0-9]+[ \t]/, "", p); if (p != "total") print c "\t" p }'
}

# Split existing code into shards, one per component of the model's plan, in the
# plan's order; without a plan the whole target is one shard. --top N keeps the
# first N, --skip K drops the first K (next batch). With --loop, also start a
# polish session.
NH_SIGNALS='abstract[[:space:]]+class|@abstractmethod|ABC[),:]|Protocol[),:]|interface[[:space:]]+[A-Z]|implements[[:space:]]|Factory|Strategy|Builder|Manager([^A-Za-z0-9_]|$)|Registry|Provider([^A-Za-z0-9_]|$)|Adapter([^A-Za-z0-9_]|$)|Wrapper([^A-Za-z0-9_]|$)|Base[A-Z]|TypeVar|Generic\[|<[A-Z][A-Za-z]*( extends [^>]*)?>|\*\*kwargs|Options([^A-Za-z0-9_]|$)|plugin|register\('
cmd_shards() {
  _loop=; _path=; _top=0; _skip=0; _notests=; _nonprod=; _plan=; _prune=; _round=
  while [ $# -gt 0 ]; do
    case $1 in
      --plan) _plan=${2-}; shift 2 || shift ;;
      --top) _top=${2-}; shift 2 || shift ;;
      --skip) _skip=${2-}; shift 2 || shift ;;
      --loop) _loop=1; shift ;;
      --round) _round=${2-}; shift 2 || shift ;;
      --passes) shift 2 || shift ;;
      --passes=*) shift ;;
      --prune-tests) _notests=; _prune=1; shift ;;
      *) sel_flag "$1" || _path=$1; shift ;;
    esac
  done
  require_repo
  for _n in "$_top" "$_skip"; do
    case $_n in ''|*[!0-9]*) nh_die "--top and --skip take whole numbers" ;; esac
  done
  [ -z "$_plan" ] || [ -f "$_plan" ] || nh_die "plan file not found: $_plan"
  select_files "$_path" "$_notests" "$_nonprod"
  _dir=$NH_STATE/shards/$SEL_KEY
  # Don't pull the shard files from under a polish run that is still using them.
  _rd=$NH_STATE/rounds/$(nh_branch_key "$(git symbolic-ref -q --short HEAD 2>/dev/null)")
  if [ -n "$_round" ]; then
    case $_round in ''|*[!0-9]*) nh_die "--round takes a whole number" ;; esac
    [ -f "$_rd/session" ] || nh_die "no polish run in progress; start one with --loop"
  elif [ -z "$_loop" ] && [ -f "$_rd/session" ] && [ "$(sed -n 5p "$_rd/session")" = "$_dir" ]; then
    nh_die "a polish run is still using the shards in $_dir. Finish it first (nahuya mark --keep-anchor), or add --loop to start a new run."
  fi
  mkdir -p "$_dir"; rm -f "$_dir"/shard-*.txt
  _signals=$(signal_counts)
  _planned=; [ -z "$_plan" ] || _planned=$(tr -d '\r' < "$_plan")
  printf '%s\n' "$SEL_ALL" | count_lines | NH_SIG=$_signals NH_TESTS=$SEL_TESTS NH_PLAN=$_planned awk -F'\t' -v dir="$_dir" \
    -v top="$_top" -v skip="$_skip" -v notests="$_notests" -v prune="$_prune" \
    -v only="${NH_ONLY_TESTS-}" '
    BEGIN {
      m = split(ENVIRON["NH_SIG"], g, "\n")
      for (i = 1; i <= m; i++) { p = g[i]; c = p; sub(/:[0-9]+$/, "", p); sub(/.*:/, "", c); sig[p] = c + 0 }
      m = split(ENVIRON["NH_TESTS"], t, "\n"); for (i = 1; i <= m; i++) { split(t[i], f, "\t"); if (f[1] != "") tv[f[1]] = f[2] }
      # plan: "## component" headers, then one path (dir/ or file) per line.
      # A header may carry [tests] or [not tests] to correct what counts as tests.
      m = split(ENVIRON["NH_PLAN"], pl, "\n")
      for (i = 1; i <= m; i++) {
        x = pl[i]; sub(/^[ \t]+/, "", x); sub(/[ \t]+$/, "", x)
        if (x ~ /^## /) {
          nc++; x = substr(x, 4)
          if (x ~ /\[not tests\]/) ctag[nc] = "code"; else if (x ~ /\[tests\]/) ctag[nc] = "tests"
          gsub(/[ \t]*\[(not )?tests\]/, "", x); cname[nc] = x; cskip[nc] = (tolower(x) ~ /^skip/); continue
        }
        if (x == "" || x ~ /^#/) continue
        sub(/^[-*] +/, "", x); sub(/^\.\//, "", x); sub(/ +\(.*$/, "", x)
        if (x == "." || x == "all") x = ""
        if (nc == 0) { nc = 1; cname[1] = "unnamed" }
        ne++; ent[ne] = x; ecomp[ne] = nc
      }
    }
    { na++; ap[na] = $2; al[na] = $1 + 0 }
    function matches(p, e) {
      if (e == "") return 1
      if (p == e) return 1
      if (substr(e, length(e)) == "/") return index(p, e) == 1
      return index(p, e "/") == 1
    }
    END {
      # component of each file (plan mode: longest matching entry wins)
      for (a = 1; a <= na; a++) {
        comp[a] = 0
        if (ne > 0) {
          best = 0; bl = -1
          for (j = 1; j <= ne; j++) if (matches(ap[a], ent[j]) && length(ent[j]) > bl) { best = j; bl = length(ent[j]) }
          if (best) comp[a] = ecomp[best]; else comp[a] = -1
        }
        # test lines, then the test choice
        c = comp[a]; v = tv[ap[a]]
        if (c > 0 && ctag[c] == "tests") v = "all"
        if (c > 0 && ctag[c] == "code") v = ""
        tlin = (v == "all") ? al[a] : v + 0
        if (c > 0) { cm[c]++; cml[c] += al[a] }
        if (only != "" && tlin == 0) continue
        if (notests != "" && v == "all") continue
        nf++; fp[nf] = ap[a]; ffull[nf] = al[a]; ft[nf] = tlin; fcomp[nf] = c
        fl[nf] = (only != "") ? tlin : al[a]; total += fl[nf]
        if (tlin) { tl += tlin; tf++ }
        if (c > 0) ck[c]++
      }
      if (ne > 0) {
        for (i = 1; i <= nf; i++) {
          c = fcomp[i]
          if (c < 0) { ul += fl[i]; un++; d = fp[i]; if (!sub(/\/[^\/]*$/, "/", d)) d = "./"; udir[d] += fl[i]; continue }
          if (cskip[c]) { skl[c] += fl[i]; continue }
          has[c] = 1
        }
        # The plan lists the components most worth reviewing first: keep its order.
        for (c = 1; c <= nc; c++) if (has[c]) { k++; slot[c] = k; label[k] = cname[c]; ord[k] = k }
        for (i = 1; i <= nf; i++) { c = fcomp[i]; if (c > 0 && has[c]) of[i] = slot[c] }
      } else {
        k = (nf > 0); ord[1] = 1; label[1] = "everything"
        for (i = 1; i <= nf; i++) of[i] = 1
      }
      for (i = 1; i <= nf; i++) {
        s = of[i]; if (!s) continue
        if (only != "" && ft[i] < ffull[i]) body[s] = body[s] sprintf("%s (%d test lines of %d)\n", fp[i], ft[i], ffull[i])
        else body[s] = body[s] sprintf("%s (%d lines)\n", fp[i], fl[i])
        lines[s] += fl[i]; readl[s] += ffull[i]; cnt[s]++; hits[s] += sig[fp[i]]
      }
      first = skip + 1; last = (top > 0 && skip + top < k) ? skip + top : k
      sel = 0; sl = 0
      for (r = first; r <= last; r++) {
        s = ord[r]; sel++; sl += lines[s]; rd += readl[s]
        out = dir "/shard-" sel ".txt"
        printf "# nahuya shard %d of %d, component: %s. Existing code to review in full (paths relative to the repo root)\n%s", sel, last - first + 1, label[s], body[s] > out
        close(out)
        printf "shard=%s files=%d lines=%d signals=%d%s\n", out, cnt[s], lines[s], hits[s], (ne > 0 ? " component=" label[s] : "")
      }
      printf "files=%d\nlines=%d\n", nf, total
      if (notests) printf "test_lines=excluded (--no-tests)\ntest_mode=off\n"
      else printf "test_lines=%d in %d files (included; pass --no-tests to leave them out)\ntest_mode=%s\n", tl, tf, (prune ? "prune" : "dedupe")
      if (only != "") printf "scope=tests-only (test files, Rust test modules and inline tests, [tests] components; lines count test code only)\n"
      printf "shards_total=%d\nshards_selected=%d\nselected_lines=%d\n", k, sel, sl
      if (last < k) printf "remaining=%d (next batch: --skip %d)\n", k - last, last
      printf "est_tokens=%d (reading + ~15k per reviewer; verification extra)\n", rd * 12 + sel * 15000
      for (c = 1; c <= nc; c++) if (cskip[c] && skl[c]) printf "planned_skip=%s (%d lines, not reviewed)\n", cname[c], skl[c]
      for (c = 1; c <= nc; c++) if (!cskip[c] && cm[c] && !ck[c])
        printf "empty=%s (%d files, %d lines matched; none kept: %s)\n", cname[c], cm[c], cml[c],
          (only != "" ? "no test code found in them; add [tests] to the header if they are test code" : "all are tests and --no-tests is set")
      if (un) {
        printf "unassigned=%d files, %d lines are in no component; add them to the plan or to a \"## skip\" component\n", un, ul
        for (d in udir) printf "unassigned_dir=%s (%d lines)\n", d, udir[d]
      }
    }' > "$_dir/report"
  cat "$_dir/report"
  nonprod_summary
  # Whether this selection covers all the code the gate counts; nahuya mark moves
  # the gate's anchor after a cleanup only then.
  _cov=full
  [ "$SEL_KEY" = all ] || _cov="only ${_path:-.} was reviewed"
  [ -z "${NH_ONLY_TESTS-}" ] || _cov="only tests were reviewed"
  [ "${_skip:-0}" = 0 ] || _cov="earlier components were left to another batch"
  grep -q '^remaining=' "$_dir/report" && _cov="some components were left for a later batch"
  grep -q '^planned_skip=' "$_dir/report" && _cov="the plan skipped some code"
  grep -q '^unassigned=' "$_dir/report" && _cov="some code was in no component"
  rm -f "$_dir/report"
  printf '%s\n' "$_cov" > "$_dir/coverage"
  if [ -n "$_loop" ]; then
    nh_resolve_tip HEAD || nh_die "no commits yet"
    rm -rf "$_rd"; mkdir -p "$_rd"
    printf '%s\n%s\n%s\n%s\n%s\n' "$NH_TIP" "$NH_TIP" "$NH_BRANCH" \
      "$(shard_entries "$_dir"/shard-*.txt | awk -F'\t' '{ s += $2 } END { print s + 0 }')" "$_dir" > "$_rd/session"
    nh_snapshot > "$_rd/tree-1"
    _l=$(nh_ledger_path "$NH_TIP" "$NH_BRANCH"); ledger_init "$_l"
    echo "ledger=$_l"
  elif [ -n "$_round" ]; then
    # A later pass: same run and ledger; the next round's diff starts here.
    nh_snapshot > "$_rd/tree-$_round"
    echo "ledger=$(session_ledger)"
  fi
}

# A compact map of the code a run would cover, for the model to plan logical
# components from: directories with files, lines, tests, over-engineering
# signals and build manifests. --files DIR lists that directory's files.
NH_MANIFEST_RE='(^|/)(Cargo\.toml|package\.json|go\.mod|pyproject\.toml|setup\.py|pom\.xml|build\.gradle(\.kts)?|[^/]*\.csproj|mix\.exs|Gemfile|composer\.json|deno\.json|Package\.swift|CMakeLists\.txt)$'
cmd_inventory() {
  _path=; _notests=; _nonprod=; _expand=
  while [ $# -gt 0 ]; do
    case $1 in
      --files) _expand="$_expand${2-}$NH_NL"; shift 2 || shift ;;
      --top|--skip|--plan|--passes) shift 2 || shift ;;
      --passes=*) shift ;;
      --loop) shift ;;
      *) sel_flag "$1" || _path=$1; shift ;;
    esac
  done
  require_repo
  select_files "$_path" "$_notests" "$_nonprod"
  _signals=$(signal_counts)
  _manifests=$(git -c core.quotePath=false ls-files --full-name -- "$NH_TOP" 2>/dev/null | grep -E "$NH_MANIFEST_RE")
  _plan=$NH_STATE/shards/$SEL_KEY/plan.md
  _data=$(printf '%s\n' "$SEL_ALL" | while IFS= read -r _f; do [ -n "$_f" ] && nh_is_data "$_f" && printf '%s\n' "$_f"; done)
  printf '%s\n' "$SEL_ALL" | count_lines | NH_SIG=$_signals NH_TESTS=$SEL_TESTS NH_DATA=$_data NH_MAN=$_manifests NH_EXP=$_expand awk -F'\t' \
    -v plan="$_plan" -v only="${NH_ONLY_TESTS-}" '
    BEGIN {
      m = split(ENVIRON["NH_SIG"], g, "\n")
      for (i = 1; i <= m; i++) { p = g[i]; c = p; sub(/:[0-9]+$/, "", p); sub(/.*:/, "", c); sig[p] = c + 0 }
      m = split(ENVIRON["NH_TESTS"], t, "\n"); for (i = 1; i <= m; i++) { split(t[i], pf, "\t"); if (pf[1] != "") tv[pf[1]] = pf[2] }
      m = split(ENVIRON["NH_DATA"], t, "\n"); for (i = 1; i <= m; i++) if (t[i] != "") data[t[i]] = 1
      m = split(ENVIRON["NH_MAN"], mf, "\n")
      for (i = 1; i <= m; i++) { d = mf[i]; b = d; if (!sub(/\/[^\/]*$/, "/", d)) d = "./"; sub(/.*\//, "", b); man[d] = man[d] (man[d] ? "," : "") b }
      m = split(ENVIRON["NH_EXP"], ex, "\n"); for (i = 1; i <= m; i++) if (ex[i] != "") { e = ex[i]; sub(/^\.\//, "", e); if (e !~ /\/$/) e = e "/"; expand[e] = 1 }
    }
    {
      n = $1 + 0; p = $2; nf++; total += n; fpath[nf] = p; flin[nf] = n
      ft[nf] = t1 = (tv[p] == "all") ? n : tv[p] + 0; tl += t1
      isdata = (p in data); if (isdata) dat += n
      d = p; depth = 0
      while (sub(/\/[^\/]*$/, "", d)) {
        k = d "/"; if (!(k in dl)) { nd++; dirs[nd] = k; dep[k] = split(k, tmp, "/") - 1 }
        dl[k] += n; df[k]++; ds[k] += sig[p]; dt[k] += t1; if (isdata) dd[k] += n
      }
    }
    END {
      printf "# inventory: %d files, %d lines (tests: %d, data: %d)\n", nf, total, tl, dat
      printf "# tests = test files by path and name, Rust #[cfg(test)] modules and inline tests; data = json, yaml, csv and the like\n"
      if (only != "") printf "# tests-only run: only test lines are reviewed; files without them drop out unless their component is tagged [tests]\n"
      printf "# Group these into logical components for review and write the plan to:\n#   %s\n", plan
      # deepest level that keeps the listing short
      for (D = 1; D <= 12; D++) { c = 0; for (i = 1; i <= nd; i++) if (dep[dirs[i]] <= D) c++; if (c > 150) break }
      D = (D > 1) ? D - 1 : 1
      if ("./" in man) printf "./  manifest=%s\n", man["./"]
      # sort dirs by path (insertion sort; dir counts are small)
      for (i = 2; i <= nd; i++) { x = dirs[i]; j = i - 1; while (j >= 1 && dirs[j] > x) { dirs[j + 1] = dirs[j]; j-- } dirs[j + 1] = x }
      for (i = 1; i <= nd; i++) {
        k = dirs[i]; if (dep[k] > D && !(k in expand)) continue
        ind = ""; for (j = 1; j < dep[k]; j++) ind = ind "  "
        printf "%s%s  files=%d lines=%d%s%s%s%s\n", ind, k, df[k], dl[k], (dt[k] ? sprintf(" tests=%d", dt[k]) : ""), (dd[k] ? sprintf(" data=%d", dd[k]) : ""), (ds[k] ? sprintf(" signals=%d", ds[k]) : ""), (k in man ? " manifest=" man[k] : "")
        if (k in expand)
          for (f = 1; f <= nf; f++) { q = fpath[f]; r = q; sub(/\/[^\/]*$/, "/", r); if (r == k) printf "%s  %s  lines=%d%s%s\n", ind, q, flin[f], (sig[q] ? sprintf(" signals=%d", sig[q]) : ""), (tv[q] == "all" ? " test" : ft[f] ? sprintf(" tests=%d", ft[f]) : "") }
      }
      for (f = 1; f <= nf; f++) if (fpath[f] !~ /\//) printf "%s  lines=%d%s\n", fpath[f], flin[f], (sig[fpath[f]] ? sprintf(" signals=%d", sig[fpath[f]]) : "")
    }'
  nonprod_summary
  mkdir -p "$NH_STATE/shards/$SEL_KEY"
}

# Near-duplicate code across the same files a whole-repo run would review.
cmd_clones() {
  _path=; _notests=; _nonprod=; _min=6
  while [ $# -gt 0 ]; do
    case $1 in
      --min-lines) _min=${2-}; shift 2 || shift ;;
      --top|--skip|--passes) shift 2 || shift ;;
      --passes=*) shift ;;
      --loop) shift ;;
      *) sel_flag "$1" || _path=$1; shift ;;
    esac
  done
  case $_min in ''|*[!0-9]*) nh_die "--min-lines takes a whole number" ;; esac
  require_repo
  select_files "$_path" "$_notests" "$_nonprod"
  _dir=$NH_STATE/shards/$SEL_KEY; mkdir -p "$_dir"
  _out=$_dir/clones.txt
  # Reuse the files of the last `nahuya shards` for this target, so plans,
  # `## skip` blocks, --top/--skip and the test choice carry over.
  _from=selection
  if ls "$_dir"/shard-*.txt >/dev/null 2>&1; then
    SEL_FILES=$(shard_entries "$_dir"/shard-*.txt | cut -f1); _from=shards
  fi
  # Data and markup repeat by nature; look for duplicated code only.
  SEL_FILES=$(printf '%s\n' "$SEL_FILES" | while IFS= read -r _f; do [ -n "$_f" ] && ! nh_is_data "$_f" && printf '%s\n' "$_f"; done)
  _pairs=$(cd "$NH_TOP" && printf '%s\n' "$SEL_FILES" | nh_clones "$_min" | head -40)
  {
    echo "# nahuya clone candidates: near-identical code ranges (whitespace-normalized; comments and imports ignored)."
    echo "# Paths relative to the repo root. Each line: <similar lines>  <range A>  <->  <range B>"
    printf '%s\n' "$_pairs" | awk -F'\t' 'NF { printf "%d  %s:%d-%d  <->  %s:%d-%d\n", $1, $2, $3, $4, $5, $6, $7 }'
  } > "$_out"
  echo "clones=$_out"
  echo "files=$(printf '%s\n' "$SEL_FILES" | grep -c .) (from the last ${_from}; data and markup left out)"
  echo "pairs=$(printf '%s\n' "$_pairs" | grep -c .)"
}

# Short user-level commands (/nah-review, /nah-polish, ...). Plugin commands
# are always namespaced, so unprefixed names have to live in ~/.claude/skills.
NH_ALIAS_MARK='<!-- nahuya alias: managed by `nahuya aliases`; remove with `nahuya aliases remove` -->'
alias_skill() { # name description hint body
  printf -- '---\nname: %s\ndescription: "%s"\n' "$1" "$2"
  [ -z "$3" ] || printf 'argument-hint: "%s"\n' "$3"
  printf 'disable-model-invocation: true\n---\n\n%s\n\n%s\n' "$NH_ALIAS_MARK" "$4"
}
cmd_aliases() {
  _skills=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills
  case ${1:-install} in
    install)
      for _n in review polish skip stats; do
        _d=$_skills/nah-$_n
        if [ -f "$_d/SKILL.md" ] && ! grep -qF 'nahuya alias:' "$_d/SKILL.md"; then
          echo "skipped /nah-$_n: $_d/SKILL.md exists and isn't ours"; continue
        fi
        mkdir -p "$_d"
        case $_n in
          review) alias_skill nah-review "Short for /nahuya:review: report-only over-engineering review." \
            "[tests] [all | folder | base..tip]  default: your unpushed changes" \
            'Invoke the `nahuya:review` skill with the arguments: $ARGUMENTS' ;;
          polish) alias_skill nah-polish "Short for /nahuya:polish: review-and-fix loop for over-engineering." \
            "[tests] [all | folder | base..tip]  default: commits waiting to be pushed" \
            'Invoke the `nahuya:polish` skill with the arguments: $ARGUMENTS' ;;
          skip) alias_skill nah-skip "Short for /nahuya:skip: skip review of the commits up to HEAD." "" \
            "$(printf '!`nahuya skip`\n\nTell the user in one line what the output above says. If a push was blocked\nearlier in this session, run it again.')" ;;
          stats) alias_skill nah-stats "What past nahuya reviews applied and rejected in this repo." "" \
            "$(printf '!`nahuya stats`\n\nShow the output above to the user as is.')" ;;
        esac > "$_d/SKILL.md"
        echo "installed /nah-$_n"
      done
      echo "Start a new session (or /reload-plugins) to see them." ;;
    remove)
      for _d in "$_skills"/nah-*; do
        [ -f "$_d/SKILL.md" ] && grep -qF 'nahuya alias:' "$_d/SKILL.md" || continue
        rm -rf "$_d"; echo "removed /${_d##*/}"
      done ;;
    *) nh_die "usage: nahuya aliases [install|remove]" ;;
  esac
}

ledger_init() {
  mkdir -p "${1%/*}"
  [ -f "$1" ] || printf '# round\tdecision\tcategory\tid\ttext (last line per id wins)\n' > "$1"
}

session_ledger() {
  _rd=$NH_STATE/rounds/$(nh_branch_key "$(git symbolic-ref -q --short HEAD 2>/dev/null)")
  [ -f "$_rd/session" ] || return 1
  nh_ledger_path "$(sed -n 1p "$_rd/session")" "$(sed -n 3p "$_rd/session")"
}

cmd_log() {
  [ $# -ge 5 ] || nh_die "usage: nahuya log ROUND DECISION CATEGORY ID TEXT..."
  _r=$1; _d=$2; _c=$3; _id=$4; shift 4
  case $_d in applied|rejected|needs-context) ;; *) nh_die "decision must be applied, rejected or needs-context" ;; esac
  require_repo
  _l=$(session_ledger) || nh_die "no review loop in progress; start with: nahuya diff --round 1"
  ledger_init "$_l"
  _text=$(printf '%s' "$*" | tr '\t\r\n' '   ')
  _c=$(printf '%s' "$_c" | tr '\t\r\n' '   ')
  _id=$(printf '%s' "$_id" | tr '\t\r\n' '   ')
  printf 'r%s\t%s\t%s\t%s\t%s\n' "$_r" "$_d" "$_c" "$_id" "$_text" >> "$_l"
  echo "logged: $_d $_id"
}

# The gate counts only commits after HEAD from now on.
move_anchor() {
  mkdir -p "$NH_STATE/anchors"
  printf '%s\n' "$NH_TIP" > "$NH_STATE/anchors/$(nh_branch_key "$NH_BRANCH")"
  rm -f "$NH_STATE/blocks"
}

cmd_mark() {
  _keep=; _why=; [ "${1-}" = --keep-anchor ] && _keep=1
  require_repo
  nh_resolve_tip HEAD || nh_die "no commits yet"
  _rd=$NH_STATE/rounds/$(nh_branch_key "$NH_BRANCH")
  _added=; _ledger=
  if [ -f "$_rd/session" ]; then
    _a=$(sed -n 1p "$_rd/session")
    _ledger=$(nh_ledger_path "$_a" "$NH_BRANCH")
    _added=$(sed -n 4p "$_rd/session")  # size when the loop started
    # A cleanup counts as the gate's review only if it covered all the code the gate counts.
    _sd=$(sed -n 5p "$_rd/session")
    if [ -z "$_keep" ] && [ -n "$_sd" ]; then
      _why=$(cat "$_sd/coverage" 2>/dev/null)
      if [ "$_why" = full ]; then _why=; else _keep=1; _why=${_why:-"no coverage was recorded"}; fi
    fi
  fi
  [ -n "$_keep" ] || move_anchor
  if [ -n "$_ledger" ]; then
    _counts=$(nh_ledger_final "$_ledger" | awk -F'\t' '{ c[$1]++ } END { printf "%d\t%d\t%d", c["applied"], c["rejected"], c["needs-context"] }')
    [ -f "$NH_STATE/runs.tsv" ] || printf '# date\tbranch\tanchor\thead\tadded_lines\tapplied\trejected\tneeds_context\n' > "$NH_STATE/runs.tsv"
    printf '%s\t%s\t%.12s\t%.12s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${NH_BRANCH:-detached}" \
      "$_a" "$NH_TIP" "${_added:-0}" "$_counts" >> "$NH_STATE/runs.tsv"
  fi
  rm -rf "$_rd"
  if [ -n "$_keep" ]; then echo "nahuya: review recorded; the push gate's anchor is unchanged${_why:+ because $_why}"
  else echo "nahuya: $(nh_short "$NH_TIP") marked as reviewed"; fi
}

# Skipping is the user's decision about this code, so it moves the anchor like a
# review would: the gate won't count these lines again on the next push.
cmd_skip() {
  require_repo
  nh_resolve_tip HEAD || nh_die "no commits yet"
  _a=$(nh_anchor "$NH_TIP" "$NH_BRANCH" 2>/dev/null) && _n=$(nh_count_added "$_a" "$NH_TIP" "$NH_BRANCH") || _n=0
  move_anchor
  echo "nahuya: skipped review of $_n added lines up to $(nh_short "$NH_TIP"); the gate counts only commits after it"
}

# Sets KEY to VALUE in the front matter of .nahuya.md, creating the file or the
# front matter if needed; an empty VALUE removes KEY. Accepts either spelling of
# a key already there (max-rounds, max_rounds).
md_set() {
  _f=$NH_TOP/.nahuya.md; _t=$(nh_tmp)
  { [ ! -f "$_f" ] || tr -d '\r' < "$_f"; } | NH_K=$1 NH_V=$2 awk '
    BEGIN { k = ENVIRON["NH_K"]; v = ENVIRON["NH_V"]; kn = k; gsub(/-/, "_", kn); line = k ": " v }
    function name(l) { sub(/:.*/, "", l); gsub(/-/, "_", l); return l }
    NR == 1 && $0 == "---" { fm = 1; print; next }
    NR == 1 { if (v != "") print "---\n" line "\n---"; done = 1; print; next }
    fm == 1 && $0 == "---" { if (!done && v != "") print line; done = 1; fm = 2; print; next }
    fm == 1 && $0 ~ /^[A-Za-z_-]+:/ && name($0) == kn { if (!done && v != "") print line; done = 1; next }
    { print }
    END { if (!done && v != "") { if (NR == 0) print "---"; print line; if (NR == 0 || fm == 1) print "---" } }' > "$_t" &&
    cat "$_t" > "$_f"
  _rc=$?; rm -f "$_t"; return $_rc
}

cmd_config() {
  _scope=; _args=
  for _a in "$@"; do
    case $_a in
      --global|--project) [ -z "$_scope" ] || nh_die "use --global or --project, not both"; _scope=$_a ;;
      *) _args="$_args$_a$NH_NL" ;;
    esac
  done
  _o=$IFS; IFS=$NH_NL; set -f; set -- $_args; set +f; IFS=$_o
  _inrepo=; nh_enter_repo && _inrepo=1
  if [ $# -ge 1 ]; then
    _k=$(nh_key "$1") || nh_die "unknown setting '$1'. Settings: $(printf '%s' "$NH_KEYS" | tr _ -)"
    [ "$_scope" = --global ] || [ -n "$_inrepo" ] || nh_die "not inside a git repository; add --global"
    _dk=$(printf '%s' "$_k" | tr _ -)
    if [ $# -ge 2 ]; then
      _v=
      if [ "$2" != --unset ]; then _v=$(nh_norm "$_k" "$2") || nh_die "invalid value '$2' for $1. $(valid_values "$_k")"; fi
      case $_scope in
        --project) md_set "$_dk" "$_v" || nh_die "could not write $NH_TOP/.nahuya.md" ;;
        *) if [ -n "$_v" ]; then git config $_scope "nahuya.$_dk" "$_v" || nh_die "could not write git config"
           else git config $_scope --unset "nahuya.$_dk" 2>/dev/null; fi ;;
      esac
    fi
  fi
  printf 'nahuya settings%s\n' "${_inrepo:+ for $NH_TOP}"
  for _k in $NH_KEYS; do
    _vs=$(nh_cfg_src "$_k")
    printf '  %-15s %-9s %s\n' "$(printf '%s' "$_k" | tr _ -)" "${_vs%%"$NH_TAB"*}" "(${_vs#*"$NH_TAB"})"
  done
  echo "Change: /nahuya:config, or nahuya config KEY VALUE with --global (all your repos) or --project (.nahuya.md, for everyone); without either, this repo only."
}

valid_values() {
  case $1 in
    gate) echo "Use on or off." ;;
    threshold|max_rounds|passes) echo "Use a whole number of 1 or more." ;;
    reviewer_model) echo "Use inherit, opus, fable, sonnet or haiku." ;;
    fix_mode) echo "Use commit, amend or uncommitted." ;;
    depth) echo "Use auto, normal or deep." ;;
  esac
}

cmd_stats() {
  require_repo
  _ledgers=$(ls "$NH_STATE"/ledger/*.tsv 2>/dev/null)
  if [ -z "$_ledgers" ] && [ ! -f "$NH_STATE/runs.tsv" ]; then echo "nahuya: no reviews recorded in this repo yet"; return; fi
  [ -z "$_ledgers" ] || echo "Findings by category (final decision per finding):"
  if [ -n "$_ledgers" ]; then
    _o=$IFS; IFS=$NH_NL; set -f
    for _l in $_ledgers; do nh_ledger_final "$_l"; done
    set +f; IFS=$_o
  fi | awk -F'\t' '
    NF >= 3 { t[$2]++; d[$2, $1]++; all[$1]++; n++ }
    END {
      if (!n) exit
      printf "  %-24s %7s %8s %8s %13s\n", "category", "total", "applied", "rejected", "needs-context"
      for (c in t) printf "  %-24s %7d %8d %8d %13d\n", c, t[c], d[c, "applied"], d[c, "rejected"], d[c, "needs-context"]
      printf "  %-24s %7d %8d %8d %13d\n", "all", n, all["applied"], all["rejected"], all["needs-context"]
      printf "  applied rate: %.0f%%\n", 100 * all["applied"] / n
    }'
  if [ -f "$NH_STATE/runs.tsv" ]; then
    echo "Runs by unreviewed size:"
    awk -F'\t' '!/^#/ && NF >= 8 {
        s = $5 + 0; b = s < 500 ? "<500" : s < 1000 ? "500-999" : s < 2000 ? "1000-1999" : "2000+"
        r[b]++; a[b] += $6; j[b] += $7; x[b] += $8 }
      END { printf "  %-10s %5s %13s %14s\n", "lines", "runs", "applied/run", "rejected/run"
        split("<500 500-999 1000-1999 2000+", order, " ")
        for (i = 1; i <= 4; i++) { k = order[i]; if (r[k]) printf "  %-10s %5d %13.1f %14.1f\n", k, r[k], a[k] / r[k], j[k] / r[k] } }' "$NH_STATE/runs.tsv"
  fi
}

_cmd=${1-help}; [ $# -gt 0 ] && shift
case $_cmd in
  status) cmd_status "$@" ;;
  diff) cmd_diff "$@" ;;
  shards) cmd_shards "$@" ;;
  aliases) cmd_aliases "$@" ;;
  inventory) cmd_inventory "$@" ;;
  clones) cmd_clones "$@" ;;
  log) cmd_log "$@" ;;
  mark) cmd_mark "$@" ;;
  skip) cmd_skip "$@" ;;
  config) cmd_config "$@" ;;
  stats) cmd_stats "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
