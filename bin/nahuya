#!/bin/sh
# nahuya CLI: state and diffs for the over-engineering review loop.
# Run `nahuya help` for usage.

NH_ROOT=$(cd "$(dirname "$0")/.." && pwd) || exit 1
. "$NH_ROOT/lib/nahuya.sh"

usage() {
  cat <<'EOF'
nahuya status [base..tip]                           range, settings and loop context
nahuya diff --round K [--full] [--only-tests] [base..tip]  write the diff for review round K
nahuya diff --target [range|branch]                 write a diff for a one-off review
nahuya shards [all|PATH] [--top N|--skip K|--fit N|--max-lines N] [--no-tests|--prune-tests|--only-tests]
              [--with-nonprod] [--loop]             split existing code into ranked review shards
nahuya inventory [all|PATH] [--files DIR] [--no-tests] [--with-nonprod]
                                                    map of directories for planning components
nahuya shards ... --plan FILE                       shards from a plan of "## component" blocks
nahuya clones [all|PATH] [--min-lines N] [--no-tests]  find near-duplicate code across files
nahuya log ROUND DECISION CATEGORY ID TEXT...       record a decision (applied|rejected|needs-context)
nahuya mark [--keep-anchor]                         mark HEAD as reviewed (ends a loop)
nahuya skip                                         let the next push of HEAD skip the gate
nahuya config [KEY [VALUE|--unset] [--global]]      show or change settings
nahuya stats                                        what past reviews applied and rejected
nahuya aliases [install|remove]                     short /nah-review, /nah-polish, ... commands
EOF
}

require_repo() { nh_enter_repo || nh_die "not inside a git repository"; }

# Sets ANCHOR, BASE (review base), NH_TIP, NH_BRANCH from an optional base..tip.
resolve_range() {
  case ${1-} in
    *...*) _b=${1%%...*}; _t=${1##*...} ;;
    *..*) _b=${1%%..*}; _t=${1##*..} ;;
    '') _b=; _t= ;;
    *) _b=; _t=$1 ;;
  esac
  nh_resolve_tip "${_t:-HEAD}" || nh_die "unknown revision: ${_t:-HEAD}"
  if [ -n "$_b" ]; then
    ANCHOR=$(git rev-parse -q --verify "$_b^{commit}") || nh_die "unknown revision: $_b"
    case $1 in *...*) ANCHOR=$(git merge-base "$ANCHOR" "$NH_TIP") ;; esac
    BASE=$ANCHOR
  else
    ANCHOR=$(nh_anchor "$NH_TIP" "$NH_BRANCH") ||
      nh_die "no upstream or remote default branch to compare against; pass a range like main..HEAD"
    BASE=$(nh_review_base "$ANCHOR" "$NH_TIP" "$NH_BRANCH")
  fi
}

cmd_status() {
  require_repo
  if [ -n "${1-}" ]; then
    resolve_range "$1"
  else
    nh_resolve_tip HEAD || nh_die "no commits yet"
    if ANCHOR=$(nh_anchor "$NH_TIP" "$NH_BRANCH"); then
      BASE=$(nh_review_base "$ANCHOR" "$NH_TIP" "$NH_BRANCH")
    else
      ANCHOR=; BASE=
    fi
  fi
  if git for-each-ref --contains "$NH_TIP" --format=x refs/remotes 2>/dev/null | grep -q .; then _pushed=yes; else _pushed=no; fi
  echo "repo=$NH_TOP"
  echo "branch=${NH_BRANCH:-(detached)}"
  if [ -n "$ANCHOR" ]; then
    echo "range=$(nh_short "$BASE")..$(nh_short "$NH_TIP")"
    echo "unreviewed_added_lines=$(nh_count_added "$ANCHOR" "$NH_TIP" "$NH_BRANCH") (non-test, non-generated)"
  else
    echo "range=none (no upstream or remote default branch; pass base..tip, or review a path)"
  fi
  for _k in $NH_KEYS; do echo "$_k=$(nh_cfg "$_k")"; done
  echo "head_pushed=$_pushed"
  echo "check=$(nh_md_scalar check)"
  if _l=$(session_ledger); then echo "ledger=$_l (review loop in progress)"
  elif [ -n "$ANCHOR" ]; then echo "ledger=$(nh_ledger_path "$ANCHOR" "$NH_BRANCH")"; fi
  [ -n "$BASE" ] || return 0
  _range_files=$(git -c core.quotePath=false diff --name-only --no-renames "$BASE" "$NH_TIP" 2>/dev/null)
  git -c core.quotePath=false status --porcelain=v1 -uno 2>/dev/null | cut -c4- |
    NH_RF=$_range_files awk 'BEGIN { n = split(ENVIRON["NH_RF"], a, "\n"); for (i = 1; i <= n; i++) r[a[i]] = 1 } ($0 in r) { print "uncommitted=" $0 }'
}

cmd_diff() {
  _round=; _full=; _target=; _has_target=
  while [ $# -gt 0 ]; do
    case $1 in
      --round) _round=${2-}; shift 2 || shift ;;
      --only-tests) export NH_ONLY_TESTS=1; shift ;;
      --full) _full=1; shift ;;
      --target) _has_target=1; shift ;;
      *) if [ -n "$_has_target" ]; then _target=$1; else _range=$1; fi; shift ;;
    esac
  done
  require_repo
  mkdir -p "$NH_STATE"
  if [ -n "$_has_target" ]; then diff_target "$_target"; return; fi
  case $_round in ''|*[!0-9]*) nh_die "usage: nahuya diff --round K [--full] [range]" ;; esac
  if [ "$_round" -le 1 ]; then resolve_range "${_range-}"; else nh_resolve_tip HEAD || nh_die "no commits yet"; fi
  _rd=$NH_STATE/rounds/$(nh_branch_key "$NH_BRANCH")
  _out=$_rd/round-$_round.diff
  if [ "$_round" -le 1 ]; then
    rm -rf "$_rd"; mkdir -p "$_rd"
    printf '%s\n%s\n%s\n%s\n' "$ANCHOR" "$BASE" "$NH_BRANCH" "$(nh_count_added "$ANCHOR" "$NH_TIP" "$NH_BRANCH")" > "$_rd/session"
    nh_snapshot > "$_rd/tree-1"
    ledger_init "$(nh_ledger_path "$ANCHOR" "$NH_BRANCH")"
    _n=$(nh_write_diff "$BASE" "$NH_TIP" "$_out")
  else
    [ -f "$_rd/session" ] || nh_die "no review loop in progress; start with: nahuya diff --round 1"
    _prev=$NH_STATE/rounds/$(nh_branch_key "$NH_BRANCH")/tree-$((_round - 1))
    [ -f "$_prev" ] || nh_die "round $((_round - 1)) was not started"
    _now=$(nh_snapshot); printf '%s\n' "$_now" > "$_rd/tree-$_round"
    if [ -n "$_full" ]; then
      _n=$(nh_write_diff "$(sed -n 2p "$_rd/session")" "$_now" "$_out")
    else
      _n=$(nh_write_diff "$(cat "$_prev")" "$_now" "$_out")
    fi
  fi
  echo "diff=$_out"
  echo "files=$_n"
  echo "lines=$(wc -l < "$_out" | tr -d ' ')"
  [ -z "${NH_ONLY_TESTS-}" ] || echo "scope=tests-only"
}

diff_target() {
  _out=$NH_STATE/review.diff
  case $1 in
    '')
      nh_resolve_tip HEAD || nh_die "no commits yet"
      _a=$(nh_anchor "$NH_TIP" "$NH_BRANCH") || nh_die "nothing to compare against; pass a range like main..HEAD"
      _n=$(nh_write_diff "$(nh_review_base "$_a" "$NH_TIP" "$NH_BRANCH")" "$(nh_snapshot)" "$_out")
      if [ "$_n" = 0 ] && git rev-parse -q --verify HEAD~1 >/dev/null 2>&1; then
        _n=$(nh_write_diff HEAD~1 HEAD "$_out")
        echo "note=nothing unreviewed; showing the last commit instead"
      fi ;;
    *..*)
      resolve_range "$1"; _n=$(nh_write_diff "$BASE" "$NH_TIP" "$_out") ;;
    *)
      nh_resolve_tip "$1" || nh_die "not a revision or range: $1 (for a path, use: nahuya shards $1)"
      _b=$(nh_fallback_base "$NH_TIP" "$NH_BRANCH") || nh_die "nothing to compare $1 against; pass a range"
      _n=$(nh_write_diff "$_b" "$NH_TIP" "$_out") ;;
  esac
  echo "diff=$_out"
  echo "files=$_n"
  echo "lines=$(wc -l < "$_out" | tr -d ' ')"
}

# Files for a whole-repo or folder run, one per line, grouped by directory.
# Sets SEL_FILES, SEL_TESTS (test files among them), SEL_KEY (state dir name).
# Options: --no-tests, --with-nonprod. Non-production dirs are skipped by
# default and reported by `nahuya shards`.
select_files() {
  _target=${1:-.}; _notests=$2; _nonprod=$3
  if [ "$_target" = all ] && [ ! -e all ]; then _target=$NH_TOP; fi
  SEL_KEY=$(printf '%s' "${1:-all}" | sed 's#^\./##; s#/*$##')
  case $SEL_KEY in ''|.|all) SEL_KEY=all ;; esac
  SEL_KEY=$(printf '%s' "$SEL_KEY" | tr -c 'A-Za-z0-9._-' '_')
  _all=$(git -c core.quotePath=false grep -I -l --full-name -e '' -- "$_target" 2>/dev/null | nh_keep review)
  if [ -d "$_target" ]; then
    _all=$(printf '%s\n' "$_all" | while IFS= read -r _f; do nh_is_doc "$_f" || printf '%s\n' "$_f"; done)
  fi
  [ -n "$_all" ] || nh_die "no tracked text files to review under $_target"
  SEL_SKIPPED=
  if [ -z "$_nonprod" ]; then
    SEL_SKIPPED=$(printf '%s\n' "$_all" | grep -E "$NH_NONPROD_RE")
    _all=$(printf '%s\n' "$_all" | grep -v -E "$NH_NONPROD_RE")
  fi
  if [ -n "${NH_ONLY_TESTS-}" ]; then
    [ -z "$_notests" ] || nh_die "--only-tests and --no-tests contradict each other"
    SEL_TESTS=$_all
  else
    SEL_TESTS=$(printf '%s\n' "$_all" | while IFS= read -r _f; do [ -n "$_f" ] && nh_is_test "$_f" && printf '%s\n' "$_f"; done)
  fi
  if [ -n "$_notests" ] && [ -n "$SEL_TESTS" ]; then
    _all=$(printf '%s\n' "$_all" | NH_T=$SEL_TESTS awk 'BEGIN { n = split(ENVIRON["NH_T"], t, "\n"); for (i = 1; i <= n; i++) skip[t[i]] = 1 } !($0 in skip)')
  fi
  # group by directory: sort by (dirname, path)
  SEL_FILES=$(printf '%s\n' "$_all" | awk 'NF { d = $0; if (!sub(/\/[^\/]*$/, "", d)) d = "."; print d "\t" $0 }' | LC_ALL=C sort | cut -f2-)
}

# Line counts for a file list on stdin ("count<TAB>path").
count_lines() {
  (cd "$NH_TOP" && tr '\n' '\000' | xargs -0 wc -l 2>/dev/null) |
    awk '{ c = $1; p = $0; sub(/^[ \t]*[0-9]+[ \t]/, "", p); if (p != "total") print c "\t" p }'
}

# Split existing code into shards of whole files, keeping each directory in one
# shard when it fits, ranked by cheap over-engineering signals. --top N keeps
# the N most suspicious, --skip K drops the first K (next batch), --fit N grows
# shards until everything fits in N. With --loop, also start a polish session.
NH_SIGNALS='abstract[[:space:]]+class|@abstractmethod|ABC[),:]|Protocol[),:]|interface[[:space:]]+[A-Z]|implements[[:space:]]|Factory|Strategy|Builder|Manager([^A-Za-z0-9_]|$)|Registry|Provider([^A-Za-z0-9_]|$)|Adapter([^A-Za-z0-9_]|$)|Wrapper([^A-Za-z0-9_]|$)|Base[A-Z]|TypeVar|Generic\[|<[A-Z][A-Za-z]*( extends [^>]*)?>|\*\*kwargs|Options([^A-Za-z0-9_]|$)|plugin|register\('
cmd_shards() {
  _max=; _loop=; _path=; _top=0; _skip=0; _fit=0; _notests=; _nonprod=; _plan=; _prune=
  while [ $# -gt 0 ]; do
    case $1 in
      --plan) _plan=${2-}; shift 2 || shift ;;
      --max-lines) _max=${2-}; shift 2 || shift ;;
      --top) _top=${2-}; shift 2 || shift ;;
      --skip) _skip=${2-}; shift 2 || shift ;;
      --fit) _fit=${2-}; shift 2 || shift ;;
      --loop) _loop=1; shift ;;
      --no-tests) _notests=1; shift ;;
      --tests) _notests=; shift ;;
      --prune-tests) _notests=; _prune=1; shift ;;
      --only-tests) export NH_ONLY_TESTS=1; shift ;;
      --with-nonprod) _nonprod=1; shift ;;
      *) _path=$1; shift ;;
    esac
  done
  require_repo
  [ -n "$_max" ] || _max=$(nh_cfg shard_lines)
  for _n in "$_max" "$_top" "$_skip" "$_fit"; do
    case $_n in ''|*[!0-9]*) nh_die "--max-lines, --top, --skip and --fit take whole numbers" ;; esac
  done
  if [ -n "$_plan" ]; then
    [ -f "$_plan" ] || nh_die "plan file not found: $_plan"
    [ "$_fit" = 0 ] || nh_die "--fit doesn't apply to a plan; merge components in the plan instead"
  fi
  select_files "$_path" "$_notests" "$_nonprod"
  _dir=$NH_STATE/shards/$SEL_KEY
  mkdir -p "$_dir"; rm -f "$_dir"/shard-*.txt
  _signals=$(cd "$NH_TOP" && printf '%s\n' "$SEL_FILES" | tr '\n' '\000' |
    xargs -0 git -c core.quotePath=false grep -I -c -E "$NH_SIGNALS" -- 2>/dev/null)
  _skipped=$(printf '%s\n' "$SEL_SKIPPED" | grep . | count_lines | awk -F'\t' -v re="$NH_NONPROD_RE" '
    { p = $2; if (match(p, re)) { k = substr(p, 1, RSTART + RLENGTH - 1); sub(/^\//, "", k); s[k] += $1 } }
    END { for (k in s) printf "%s %d\n", k, s[k] }' | sort -k2,2nr | head -8)
  _planned=; [ -z "$_plan" ] || _planned=$(tr -d '\r' < "$_plan")
  printf '%s\n' "$SEL_FILES" | count_lines | NH_SIG=$_signals NH_TESTS=$SEL_TESTS NH_PLAN=$_planned awk -F'\t' -v max="$_max" -v dir="$_dir" \
    -v top="$_top" -v skip="$_skip" -v fit="$_fit" -v agents="$(nh_cfg max_agents)" -v notests="$_notests" -v prune="$_prune" '
    BEGIN {
      m = split(ENVIRON["NH_SIG"], g, "\n")
      for (i = 1; i <= m; i++) { p = g[i]; c = p; sub(/:[0-9]+$/, "", p); sub(/.*:/, "", c); sig[p] = c + 0 }
      m = split(ENVIRON["NH_TESTS"], t, "\n"); for (i = 1; i <= m; i++) if (t[i] != "") istest[t[i]] = 1
      # plan: "## component" headers, then one path (dir/ or file) per line
      m = split(ENVIRON["NH_PLAN"], pl, "\n")
      for (i = 1; i <= m; i++) {
        x = pl[i]; sub(/^[ \t]+/, "", x); sub(/[ \t]+$/, "", x)
        if (x ~ /^## /) { nc++; cname[nc] = substr(x, 4); cskip[nc] = (tolower(cname[nc]) ~ /^skip/); continue }
        if (x == "" || x ~ /^#/) continue
        sub(/^[-*] +/, "", x); sub(/^\.\//, "", x); sub(/ +\(.*$/, "", x)
        if (x == "." || x == "all") x = ""
        if (nc == 0) { nc = 1; cname[1] = "unnamed" }
        ne++; ent[ne] = x; ecomp[ne] = nc
      }
    }
    {
      nf++; fp[nf] = $2; fl[nf] = $1 + 0; total += fl[nf]
      if ($2 in istest) { tl += fl[nf]; tf++ }
      d = $2; if (!sub(/\/[^\/]*$/, "", d)) d = "."
      if (nf == 1 || d != lastd) { ng++; gs[ng] = nf; lastd = d }
      ge[ng] = nf; gl[ng] += fl[nf]
    }
    function pack(lim,   j, i, k, cur) {
      k = 0; cur = 0
      for (j = 1; j <= ng; j++) {
        if (gl[j] <= lim) {
          if (k == 0 || (cur > 0 && cur + gl[j] > lim)) { k++; cur = 0 }
          for (i = gs[j]; i <= ge[j]; i++) of[i] = k
          cur += gl[j]
        } else {
          if (k == 0 || cur > 0) { k++; cur = 0 }
          for (i = gs[j]; i <= ge[j]; i++) { if (cur > 0 && cur + fl[i] > lim) { k++; cur = 0 } of[i] = k; cur += fl[i] }
        }
      }
      return k
    }
    function matches(p, e) {
      if (e == "") return 1
      if (p == e) return 1
      if (substr(e, length(e)) == "/") return index(p, e) == 1
      return index(p, e "/") == 1
    }
    END {
      if (ne > 0) {
        # plan mode: longest matching entry wins; shards follow plan order
        for (i = 1; i <= nf; i++) {
          best = 0; bl = -1
          for (j = 1; j <= ne; j++) if (matches(fp[i], ent[j]) && length(ent[j]) > bl) { best = j; bl = length(ent[j]) }
          if (!best) { ul += fl[i]; un++; d = fp[i]; if (!sub(/\/[^\/]*$/, "/", d)) d = "./"; udir[d] += fl[i]; continue }
          c = ecomp[best]
          if (cskip[c]) { skl[c] += fl[i]; continue }
          if (!(c in slot)) { k++; slot[c] = k; label[k] = cname[c] }
          of[i] = slot[c]
        }
        for (s = 1; s <= k; s++) ord[s] = s
      } else {
        if (fit > 0) { max = int(total / fit) + 1; while (pack(max) > fit) max = int(max * 1.1) + 1 }
        k = pack(max)
      }
      for (i = 1; i <= nf; i++) {
        s = of[i]; if (!s) continue
        body[s] = body[s] sprintf("%s (%d lines)\n", fp[i], fl[i])
        lines[s] += fl[i]; cnt[s]++; hits[s] += sig[fp[i]]
      }
      if (ne == 0) {
        for (s = 1; s <= k; s++) { score[s] = lines[s] ? hits[s] * 1000 / lines[s] : 0; ord[s] = s }
        for (a = 1; a <= k; a++) for (b = a + 1; b <= k; b++)
          if (score[ord[b]] > score[ord[a]] || (score[ord[b]] == score[ord[a]] && lines[ord[b]] > lines[ord[a]])) { x = ord[a]; ord[a] = ord[b]; ord[b] = x }
      }
      first = skip + 1; last = (top > 0 && skip + top < k) ? skip + top : k
      sel = 0; sl = 0
      for (r = first; r <= last; r++) {
        s = ord[r]; sel++; sl += lines[s]
        out = dir "/shard-" sel ".txt"
        if (ne > 0) printf "# nahuya shard %d of %d, component: %s. Existing code to review in full (paths relative to the repo root)\n%s", sel, last - first + 1, label[s], body[s] > out
        else printf "# nahuya shard %d of %d (rank %d of %d by over-engineering signals): existing code to review in full (paths relative to the repo root)\n%s", sel, last - first + 1, r, k, body[s] > out
        close(out)
        printf "shard=%s files=%d lines=%d signals=%d%s\n", out, cnt[s], lines[s], hits[s], (ne > 0 ? " component=" label[s] : "")
        if (ne > 0 && lines[s] > 2 * max) printf "warning=component \"%s\" has %d lines, over twice shard-lines (%d); consider splitting it\n", label[s], lines[s], max
      }
      printf "files=%d\nlines=%d\n", nf, total
      if (notests) printf "test_lines=excluded (--no-tests)\ntest_mode=off\n"
      else printf "test_lines=%d in %d files (included; pass --no-tests to leave them out)\ntest_mode=%s\n", tl, tf, (prune ? "prune" : "dedupe")
      if (ENVIRON["NH_ONLY_TESTS"] != "") printf "scope=tests-only (test files, plus sources with inline tests)\n"
      printf "shard_lines=%d\nshards_total=%d\nshards_selected=%d\nselected_lines=%d\n", max, k, sel, sl
      if (last < k) printf "remaining=%d (next batch: --skip %d)\n", k - last, last
      printf "max_agents=%d\nest_tokens=%d (reading + ~15k per reviewer; verification extra)\n", agents, sl * 12 + sel * 15000
      for (c = 1; c <= nc; c++) if (cskip[c] && skl[c]) printf "planned_skip=%s (%d lines, not reviewed)\n", cname[c], skl[c]
      if (un) {
        printf "unassigned=%d files, %d lines are in no component; add them to the plan or to a \"## skip\" component\n", un, ul
        for (d in udir) printf "unassigned_dir=%s (%d lines)\n", d, udir[d]
      }
    }'
  [ -z "$_skipped" ] || printf '%s\n' "$_skipped" | awk '{ printf "skipped_nonprod=%s (%d lines; pass --with-nonprod to include)\n", $1, $2 }'
  if [ -n "$_loop" ]; then
    nh_resolve_tip HEAD || nh_die "no commits yet"
    _rd=$NH_STATE/rounds/$(nh_branch_key "$NH_BRANCH")
    rm -rf "$_rd"; mkdir -p "$_rd"
    printf '%s\n%s\n%s\n%s\n' "$NH_TIP" "$NH_TIP" "$NH_BRANCH" \
      "$(cat "$_dir"/shard-*.txt | sed -n 's/.* (\([0-9]*\) lines)$/\1/p' | awk '{ s += $1 } END { print s + 0 }')" > "$_rd/session"
    nh_snapshot > "$_rd/tree-1"
    _l=$(nh_ledger_path "$NH_TIP" "$NH_BRANCH"); ledger_init "$_l"
    echo "ledger=$_l"
  fi
}

# A compact map of the code a run would cover, for the model to plan logical
# components from: directories with files, lines, tests, over-engineering
# signals and build manifests. --files DIR lists that directory's files.
NH_MANIFEST_RE='(^|/)(Cargo\.toml|package\.json|go\.mod|pyproject\.toml|setup\.py|pom\.xml|build\.gradle(\.kts)?|[^/]*\.csproj|mix\.exs|Gemfile|composer\.json|deno\.json|Package\.swift|CMakeLists\.txt)$'
cmd_inventory() {
  _path=; _notests=; _nonprod=; _expand=
  while [ $# -gt 0 ]; do
    case $1 in
      --files) _expand="$_expand${2-}$NH_NL"; shift 2 || shift ;;
      --no-tests) _notests=1; shift ;;
      --tests) _notests=; shift ;;
      --prune-tests) _notests=; _prune=1; shift ;;
      --only-tests) export NH_ONLY_TESTS=1; shift ;;
      --with-nonprod) _nonprod=1; shift ;;
      --top|--skip|--fit|--max-lines|--plan) shift 2 || shift ;;
      --loop) shift ;;
      *) _path=$1; shift ;;
    esac
  done
  require_repo
  select_files "$_path" "$_notests" "$_nonprod"
  _signals=$(cd "$NH_TOP" && printf '%s\n' "$SEL_FILES" | tr '\n' '\000' |
    xargs -0 git -c core.quotePath=false grep -I -c -E "$NH_SIGNALS" -- 2>/dev/null)
  _manifests=$(git -c core.quotePath=false ls-files --full-name -- "$NH_TOP" 2>/dev/null | grep -E "$NH_MANIFEST_RE")
  _plan=$NH_STATE/shards/$SEL_KEY/plan.md
  printf '%s\n' "$SEL_FILES" | count_lines | NH_SIG=$_signals NH_TESTS=$SEL_TESTS NH_MAN=$_manifests NH_EXP=$_expand awk -F'\t' \
    -v shard="$(nh_cfg shard_lines)" -v agents="$(nh_cfg max_agents)" -v plan="$_plan" '
    BEGIN {
      m = split(ENVIRON["NH_SIG"], g, "\n")
      for (i = 1; i <= m; i++) { p = g[i]; c = p; sub(/:[0-9]+$/, "", p); sub(/.*:/, "", c); sig[p] = c + 0 }
      m = split(ENVIRON["NH_TESTS"], t, "\n"); for (i = 1; i <= m; i++) if (t[i] != "") istest[t[i]] = 1
      m = split(ENVIRON["NH_MAN"], mf, "\n")
      for (i = 1; i <= m; i++) { d = mf[i]; b = d; if (!sub(/\/[^\/]*$/, "/", d)) d = "./"; sub(/.*\//, "", b); man[d] = man[d] (man[d] ? "," : "") b }
      m = split(ENVIRON["NH_EXP"], ex, "\n"); for (i = 1; i <= m; i++) if (ex[i] != "") { e = ex[i]; sub(/^\.\//, "", e); if (e !~ /\/$/) e = e "/"; expand[e] = 1 }
    }
    {
      n = $1 + 0; p = $2; nf++; total += n; fpath[nf] = p; flin[nf] = n
      ist = (p in istest); if (ist) tl += n
      d = p; depth = 0
      while (sub(/\/[^\/]*$/, "", d)) {
        k = d "/"; if (!(k in dl)) { nd++; dirs[nd] = k; dep[k] = split(k, tmp, "/") - 1 }
        dl[k] += n; df[k]++; ds[k] += sig[p]; if (ist) dt[k] += n
      }
    }
    END {
      printf "# inventory: %d files, %d lines (tests: %d), shard-lines %d, max-agents %d\n", nf, total, tl, shard, agents
      printf "# Group these into logical components for review and write the plan to:\n#   %s\n", plan
      # deepest level that keeps the listing short
      for (D = 1; D <= 12; D++) { c = 0; for (i = 1; i <= nd; i++) if (dep[dirs[i]] <= D) c++; if (c > 150) break }
      D = (D > 1) ? D - 1 : 1
      # sort dirs by path (insertion sort; dir counts are small)
      for (i = 2; i <= nd; i++) { x = dirs[i]; j = i - 1; while (j >= 1 && dirs[j] > x) { dirs[j + 1] = dirs[j]; j-- } dirs[j + 1] = x }
      for (i = 1; i <= nd; i++) {
        k = dirs[i]; if (dep[k] > D && !(k in expand)) continue
        ind = ""; for (j = 1; j < dep[k]; j++) ind = ind "  "
        printf "%s%s  files=%d lines=%d%s%s%s\n", ind, k, df[k], dl[k], (dt[k] ? sprintf(" tests=%d", dt[k]) : ""), (ds[k] ? sprintf(" signals=%d", ds[k]) : ""), (k in man ? " manifest=" man[k] : "")
        if (k in expand)
          for (f = 1; f <= nf; f++) { q = fpath[f]; r = q; sub(/\/[^\/]*$/, "/", r); if (r == k) printf "%s  %s  lines=%d%s%s\n", ind, q, flin[f], (sig[q] ? sprintf(" signals=%d", sig[q]) : ""), ((q in istest) ? " test" : "") }
      }
      for (f = 1; f <= nf; f++) if (fpath[f] !~ /\//) printf "%s  lines=%d%s\n", fpath[f], flin[f], (sig[fpath[f]] ? sprintf(" signals=%d", sig[fpath[f]]) : "")
      for (f = 1; f <= nf; f++) if (flin[f] >= shard) printf "big_file=%s (%d lines)\n", fpath[f], flin[f]
    }'
  [ -z "$SEL_SKIPPED" ] || printf '%s\n' "$SEL_SKIPPED" | grep . | count_lines | awk -F'\t' -v re="$NH_NONPROD_RE" '
    { p = $2; if (match(p, re)) { k = substr(p, 1, RSTART + RLENGTH - 1); sub(/^\//, "", k); s[k] += $1 } }
    END { for (k in s) printf "skipped_nonprod=%s (%d lines; pass --with-nonprod to include)\n", k, s[k] }'
  mkdir -p "$NH_STATE/shards/$SEL_KEY"
}

# Near-duplicate code across the same files a whole-repo run would review.
cmd_clones() {
  _path=; _notests=; _nonprod=; _min=6
  while [ $# -gt 0 ]; do
    case $1 in
      --min-lines) _min=${2-}; shift 2 || shift ;;
      --no-tests) _notests=1; shift ;;
      --tests) _notests=; shift ;;
      --prune-tests) _notests=; _prune=1; shift ;;
      --only-tests) export NH_ONLY_TESTS=1; shift ;;
      --with-nonprod) _nonprod=1; shift ;;
      --top|--skip|--fit|--max-lines) shift 2 || shift ;;
      --loop) shift ;;
      *) _path=$1; shift ;;
    esac
  done
  case $_min in ''|*[!0-9]*) nh_die "--min-lines takes a whole number" ;; esac
  require_repo
  select_files "$_path" "$_notests" "$_nonprod"
  _dir=$NH_STATE/shards/$SEL_KEY; mkdir -p "$_dir"
  _out=$_dir/clones.txt
  # Reuse the files of the last `nahuya shards` for this target, so plans,
  # `## skip` blocks, --top/--skip and the test choice carry over.
  _from=selection
  if ls "$_dir"/shard-*.txt >/dev/null 2>&1; then
    SEL_FILES=$(cat "$_dir"/shard-*.txt | sed -n 's/^\(.*\) ([0-9]* lines)$/\1/p'); _from=shards
  fi
  # Data and markup repeat by nature; look for duplicated code only.
  SEL_FILES=$(printf '%s\n' "$SEL_FILES" | grep -v -i -E '\.(json|jsonc|ya?ml|xml|html?|css|scss|svg|csv|tsv|toml|ini|lock|txt|md|mdx|rst|snap)$')
  _pairs=$(cd "$NH_TOP" && printf '%s\n' "$SEL_FILES" | nh_clones "$_min" | head -40)
  {
    echo "# nahuya clone candidates: near-identical code ranges (whitespace-normalized; comments and imports ignored)."
    echo "# Paths relative to the repo root. Each line: <similar lines>  <range A>  <->  <range B>"
    printf '%s\n' "$_pairs" | awk -F'\t' 'NF { printf "%d  %s:%d-%d  <->  %s:%d-%d\n", $1, $2, $3, $4, $5, $6, $7 }'
  } > "$_out"
  echo "clones=$_out"
  echo "files=$(printf '%s\n' "$SEL_FILES" | grep -c .) (from the last ${_from}; data and markup left out)"
  echo "pairs=$(printf '%s\n' "$_pairs" | grep -c .)"
}

# Short user-level commands (/nah-review, /nah-polish, ...). Plugin commands
# are always namespaced, so unprefixed names have to live in ~/.claude/skills.
NH_ALIAS_MARK='<!-- nahuya alias: managed by `nahuya aliases`; remove with `nahuya aliases remove` -->'
alias_skill() { # name description hint body
  printf -- '---\nname: %s\ndescription: %s\n' "$1" "$2"
  [ -z "$3" ] || printf 'argument-hint: "%s"\n' "$3"
  printf 'disable-model-invocation: true\n---\n\n%s\n\n%s\n' "$NH_ALIAS_MARK" "$4"
}
cmd_aliases() {
  _skills=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills
  case ${1:-install} in
    install)
      for _n in review polish skip stats; do
        _d=$_skills/nah-$_n
        if [ -f "$_d/SKILL.md" ] && ! grep -qF 'nahuya alias:' "$_d/SKILL.md"; then
          echo "skipped /nah-$_n: $_d/SKILL.md exists and isn't ours"; continue
        fi
        mkdir -p "$_d"
        case $_n in
          review) alias_skill nah-review "Short for /nahuya:review: report-only over-engineering review." \
            "[tests] [all | folder | base..tip]  default: your unpushed changes" \
            'Invoke the `nahuya:review` skill with the arguments: $ARGUMENTS' ;;
          polish) alias_skill nah-polish "Short for /nahuya:polish: review-and-fix loop for over-engineering." \
            "[tests] [all | folder | base..tip]  default: commits waiting to be pushed" \
            'Invoke the `nahuya:polish` skill with the arguments: $ARGUMENTS' ;;
          skip) alias_skill nah-skip "Short for /nahuya:skip: let the next push through the nahuya gate." "" \
            "$(printf '!`nahuya skip`\n\nTell the user in one line what the output above says. If a push was blocked\nearlier in this session, run it again.')" ;;
          stats) alias_skill nah-stats "What past nahuya reviews applied and rejected in this repo." "" \
            "$(printf '!`nahuya stats`\n\nShow the output above to the user as is.')" ;;
        esac > "$_d/SKILL.md"
        echo "installed /nah-$_n"
      done
      echo "Start a new session (or /reload-plugins) to see them." ;;
    remove)
      for _d in "$_skills"/nah-*; do
        [ -f "$_d/SKILL.md" ] && grep -qF 'nahuya alias:' "$_d/SKILL.md" || continue
        rm -rf "$_d"; echo "removed /${_d##*/}"
      done ;;
    *) nh_die "usage: nahuya aliases [install|remove]" ;;
  esac
}

ledger_init() {
  mkdir -p "${1%/*}"
  [ -f "$1" ] || printf '# round\tdecision\tcategory\tid\ttext (last line per id wins)\n' > "$1"
}

session_ledger() {
  _rd=$NH_STATE/rounds/$(nh_branch_key "$(git symbolic-ref -q --short HEAD 2>/dev/null)")
  [ -f "$_rd/session" ] || return 1
  nh_ledger_path "$(sed -n 1p "$_rd/session")" "$(sed -n 3p "$_rd/session")"
}

cmd_log() {
  [ $# -ge 5 ] || nh_die "usage: nahuya log ROUND DECISION CATEGORY ID TEXT..."
  _r=$1; _d=$2; _c=$3; _id=$4; shift 4
  case $_d in applied|rejected|needs-context) ;; *) nh_die "decision must be applied, rejected or needs-context" ;; esac
  require_repo
  _l=$(session_ledger) || nh_die "no review loop in progress; start with: nahuya diff --round 1"
  ledger_init "$_l"
  _text=$(printf '%s' "$*" | tr '\t\r\n' '   ')
  _c=$(printf '%s' "$_c" | tr '\t\r\n' '   ')
  _id=$(printf '%s' "$_id" | tr '\t\r\n' '   ')
  printf 'r%s\t%s\t%s\t%s\t%s\n' "$_r" "$_d" "$_c" "$_id" "$_text" >> "$_l"
  echo "logged: $_d $_id"
}

cmd_mark() {
  _keep=; [ "${1-}" = --keep-anchor ] && _keep=1
  require_repo
  nh_resolve_tip HEAD || nh_die "no commits yet"
  _key=$(nh_branch_key "$NH_BRANCH")
  _rd=$NH_STATE/rounds/$_key
  _added=; _ledger=
  if [ -f "$_rd/session" ]; then
    _a=$(sed -n 1p "$_rd/session")
    _ledger=$(nh_ledger_path "$_a" "$NH_BRANCH")
    _added=$(sed -n 4p "$_rd/session")  # size when the loop started
  fi
  if [ -z "$_keep" ]; then
    mkdir -p "$NH_STATE/anchors"
    printf '%s\n' "$NH_TIP" > "$NH_STATE/anchors/$_key"
    rm -f "$NH_STATE/blocks"
  fi
  if [ -n "$_ledger" ]; then
    _counts=$(nh_ledger_final "$_ledger" | awk -F'\t' '{ c[$1]++ } END { printf "%d\t%d\t%d", c["applied"], c["rejected"], c["needs-context"] }')
    [ -f "$NH_STATE/runs.tsv" ] || printf '# date\tbranch\tanchor\thead\tadded_lines\tapplied\trejected\tneeds_context\n' > "$NH_STATE/runs.tsv"
    printf '%s\t%s\t%.12s\t%.12s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${NH_BRANCH:-detached}" \
      "$(sed -n 1p "$_rd/session")" "$NH_TIP" "${_added:-0}" "$_counts" >> "$NH_STATE/runs.tsv"
  fi
  rm -rf "$_rd"
  if [ -n "$_keep" ]; then echo "nahuya: review recorded; the push gate's anchor is unchanged"
  else echo "nahuya: $(nh_short "$NH_TIP") marked as reviewed"; fi
}

cmd_skip() {
  require_repo
  nh_resolve_tip HEAD || nh_die "no commits yet"
  mkdir -p "$NH_STATE"
  printf '%s\n' "$NH_TIP" > "$NH_STATE/skip"
  echo "nahuya: the next push of $(nh_short "$NH_TIP") skips review (a new commit cancels this)"
}

cmd_config() {
  _global=; _args=
  for _a in "$@"; do
    if [ "$_a" = --global ]; then _global=--global; else _args="$_args$_a$NH_NL"; fi
  done
  _o=$IFS; IFS=$NH_NL; set -f; set -- $_args; set +f; IFS=$_o
  _inrepo=; nh_enter_repo && _inrepo=1
  if [ $# -ge 1 ]; then
    _k=$(nh_key "$1") || nh_die "unknown setting '$1'. Settings: gate threshold max-rounds model fix-mode layer shard-lines max-agents depth"
    [ -n "$_global" ] || [ -n "$_inrepo" ] || nh_die "not inside a git repository; add --global"
    _gk=nahuya.$(printf '%s' "$_k" | tr _ -)
    if [ $# -ge 2 ]; then
      if [ "$2" = --unset ]; then
        git config $_global --unset "$_gk" 2>/dev/null
      else
        _v=$(nh_norm "$_k" "$2") || nh_die "invalid value '$2' for $1. $(valid_values "$_k")"
        git config $_global "$_gk" "$_v" || nh_die "could not write git config"
      fi
    fi
  fi
  printf 'nahuya settings%s\n' "${_inrepo:+ for $NH_TOP}"
  for _k in $NH_KEYS; do
    _vs=$(nh_cfg_src "$_k")
    printf '  %-15s %-9s %s\n' "$(printf '%s' "$_k" | tr _ -)" "${_vs%%"$NH_TAB"*}" "(${_vs#*"$NH_TAB"})"
  done
  echo "Change: /plugin configure. Per repo: git config nahuya.KEY VALUE (--global for all repos, --unset to reset)."
}

valid_values() {
  case $1 in
    gate|layer) echo "Use on or off." ;;
    threshold|max_rounds|shard_lines|max_agents) echo "Use a whole number of 1 or more." ;;
    reviewer_model) echo "Use inherit, opus, fable, sonnet or haiku." ;;
    fix_mode) echo "Use commit, amend or uncommitted." ;;
    depth) echo "Use auto, normal or deep." ;;
  esac
}

cmd_stats() {
  require_repo
  _ledgers=$(ls "$NH_STATE"/ledger/*.tsv 2>/dev/null)
  if [ -z "$_ledgers" ] && [ ! -f "$NH_STATE/runs.tsv" ]; then echo "nahuya: no reviews recorded in this repo yet"; return; fi
  [ -z "$_ledgers" ] || echo "Findings by category (final decision per finding):"
  if [ -n "$_ledgers" ]; then
    _o=$IFS; IFS=$NH_NL; set -f
    for _l in $_ledgers; do nh_ledger_final "$_l"; done
    set +f; IFS=$_o
  fi | awk -F'\t' '
    NF >= 3 { t[$2]++; d[$2, $1]++; all[$1]++; n++ }
    END {
      if (!n) exit
      printf "  %-24s %7s %8s %8s %13s\n", "category", "total", "applied", "rejected", "needs-context"
      for (c in t) printf "  %-24s %7d %8d %8d %13d\n", c, t[c], d[c, "applied"], d[c, "rejected"], d[c, "needs-context"]
      printf "  %-24s %7d %8d %8d %13d\n", "all", n, all["applied"], all["rejected"], all["needs-context"]
      printf "  applied rate: %.0f%%\n", 100 * all["applied"] / n
    }'
  if [ -f "$NH_STATE/runs.tsv" ]; then
    echo "Runs by unreviewed size:"
    awk -F'\t' '!/^#/ && NF >= 8 {
        s = $5 + 0; b = s < 500 ? "<500" : s < 1000 ? "500-999" : s < 2000 ? "1000-1999" : "2000+"
        r[b]++; a[b] += $6; j[b] += $7; x[b] += $8 }
      END { printf "  %-10s %5s %13s %14s\n", "lines", "runs", "applied/run", "rejected/run"
        split("<500 500-999 1000-1999 2000+", order, " ")
        for (i = 1; i <= 4; i++) { k = order[i]; if (r[k]) printf "  %-10s %5d %13.1f %14.1f\n", k, r[k], a[k] / r[k], j[k] / r[k] } }' "$NH_STATE/runs.tsv"
  fi
}

_cmd=${1-help}; [ $# -gt 0 ] && shift
case $_cmd in
  status) cmd_status "$@" ;;
  diff) cmd_diff "$@" ;;
  shards) cmd_shards "$@" ;;
  aliases) cmd_aliases "$@" ;;
  inventory) cmd_inventory "$@" ;;
  clones) cmd_clones "$@" ;;
  log) cmd_log "$@" ;;
  mark) cmd_mark "$@" ;;
  skip) cmd_skip "$@" ;;
  config) cmd_config "$@" ;;
  stats) cmd_stats "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
